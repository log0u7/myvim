" plugin_minimap.vim - wfxr/minimap.vim (code minimap)
" Needs the code-minimap binary (cargo install code-minimap, already
" installed via mise/cargo). F4 toggles the minimap; no auto-start on
" purpose: open it when wanted.
let g:minimap_auto_start = 0
" Diff-colored file entries in the minimap.
let g:minimap_git_colors = 1
